WORKOS_CLIENT_ID=
WORKOS_API_KEY=


# Server-side Fly Sprites token (SPRITE_TOKEN is also accepted).
SPRITES_API_KEY=
# SPRITES_API_BASE_URL=https://api.sprites.dev
# Apps are served at <slug>.$APPS_DOMAIN. Use a domain separate from the main app.
# APPS_DOMAIN=hermitscale.app

# Public HTTPS origin serving the backend /hooks/:token endpoint.
INTEGRATION_WEBHOOK_BASE_URL=
# Optional: set a stable secret of at least 32 bytes on every node.
# When unset, webhook signing uses the endpoint SECRET_KEY_BASE.
# INTEGRATION_WEBHOOK_SIGNING_SECRET=
