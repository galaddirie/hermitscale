<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section id="workflow-dashboard" class="space-y-8">
    <div class="flex flex-col gap-5 border-b border-slate-200 pb-8 dark:border-slate-800 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-emerald-600 dark:text-emerald-400">
          Workflow control plane
        </p>
        <h1 class="text-3xl font-semibold tracking-tight text-slate-950 dark:text-white sm:text-4xl">
          Your automations, at a glance
        </h1>
        <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400 sm:text-base">
          Every workflow, run, and trigger is isolated to your active organization.
        </p>
      </div>

      <div class="inline-flex w-fit items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-medium text-emerald-800 dark:border-emerald-900/70 dark:bg-emerald-950/50 dark:text-emerald-300">
        <span class="size-1.5 rounded-full bg-emerald-500 shadow-[0_0_0_3px_rgba(16,185,129,0.14)]"></span>
        Scope enforced
      </div>
    </div>

    <dl class="grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm shadow-slate-950/5 dark:border-slate-800 dark:bg-slate-900">
        <dt class="text-xs font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Total
        </dt>
        <dd class="mt-2 text-3xl font-semibold tracking-tight text-slate-950 dark:text-white">
          {@workflow_counts.total}
        </dd>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm shadow-slate-950/5 dark:border-slate-800 dark:bg-slate-900">
        <dt class="text-xs font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Active
        </dt>
        <dd class="mt-2 text-3xl font-semibold tracking-tight text-emerald-600 dark:text-emerald-400">
          {@workflow_counts.active}
        </dd>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm shadow-slate-950/5 dark:border-slate-800 dark:bg-slate-900">
        <dt class="text-xs font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400">
          Draft
        </dt>
        <dd class="mt-2 text-3xl font-semibold tracking-tight text-amber-600 dark:text-amber-400">
          {@workflow_counts.draft}
        </dd>
      </div>
    </dl>

    <div>
      <div class="mb-4 flex items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold text-slate-950 dark:text-white">Workflows</h2>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
            Only resources owned by {@current_scope.organization.name} appear here.
          </p>
        </div>
      </div>

      <div
        :if={@graphs == []}
        id="workflows-empty"
        class="rounded-2xl border border-dashed border-slate-300 bg-slate-50/70 px-6 py-14 text-center dark:border-slate-700 dark:bg-slate-900/50"
      >
        <div class="mx-auto flex size-11 items-center justify-center rounded-xl bg-white text-slate-500 shadow-sm ring-1 ring-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:ring-slate-700">
          <.icon name="hero-command-line" class="size-5" />
        </div>
        <h3 class="mt-4 text-sm font-semibold text-slate-900 dark:text-white">
          No workflows yet
        </h3>
        <p class="mx-auto mt-1 max-w-sm text-sm leading-6 text-slate-500 dark:text-slate-400">
          This organization's workflow library is empty. New workflows will appear here automatically.
        </p>
      </div>

      <div :if={@graphs != []} id="workflows" class="grid gap-4 lg:grid-cols-2">
        <article
          :for={graph <- @graphs}
          id={"workflow-#{graph.id}"}
          class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm shadow-slate-950/5 transition duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-slate-700"
        >
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <h3 class="truncate text-base font-semibold text-slate-950 dark:text-white">
                {graph.name}
              </h3>
              <p class="mt-1 truncate font-mono text-xs text-slate-500 dark:text-slate-400">
                {graph.id}
              </p>
            </div>
            <span class={[
              "inline-flex shrink-0 items-center rounded-full px-2.5 py-1 text-xs font-medium ring-1 ring-inset",
              graph.status == :active &&
                "bg-emerald-50 text-emerald-700 ring-emerald-600/20 dark:bg-emerald-950/60 dark:text-emerald-300 dark:ring-emerald-400/20",
              graph.status == :draft &&
                "bg-amber-50 text-amber-700 ring-amber-600/20 dark:bg-amber-950/60 dark:text-amber-300 dark:ring-amber-400/20",
              graph.status == :archived &&
                "bg-slate-100 text-slate-600 ring-slate-500/20 dark:bg-slate-800 dark:text-slate-300 dark:ring-slate-400/20"
            ]}>
              {graph.status}
            </span>
          </div>

          <div class="mt-5 flex items-center gap-5 border-t border-slate-100 pt-4 text-xs text-slate-500 dark:border-slate-800 dark:text-slate-400">
            <span class="inline-flex items-center gap-1.5">
              <.icon name="hero-squares-2x2" class="size-4" />
              {length(graph.definition["nodes"] || [])} nodes
            </span>
            <span class="inline-flex items-center gap-1.5">
              <.icon name="hero-check-badge" class="size-4" /> Schema v{graph.schema_version}
            </span>
          </div>
        </article>
      </div>
    </div>
  </section>
</Layouts.app>
