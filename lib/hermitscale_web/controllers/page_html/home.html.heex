<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section id="welcome" class="py-12 sm:py-20">
    <div class="mb-8 flex size-14 items-center justify-center rounded-2xl bg-orange-50 text-orange-600">
      <.icon name="hero-fire" class="size-8" />
    </div>
    <h1 class="text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">
      Welcome to Hermitscale
    </h1>
    <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">
      Your Phoenix application is ready to build.
    </p>
    <nav aria-label="Getting started" class="mt-10 flex flex-wrap gap-4">
      <.button
        id="phoenix-guides"
        href="https://hexdocs.pm/phoenix/overview.html"
        variant="primary"
      >
        Phoenix guides <.icon name="hero-arrow-up-right" class="ml-2 size-4" />
      </.button>
      <.button id="phoenix-docs" href="https://hexdocs.pm/phoenix">
        Documentation
      </.button>
    </nav>
  </section>
</Layouts.app>
