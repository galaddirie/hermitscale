<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="mx-auto grid max-w-6xl items-center gap-12 py-8 lg:grid-cols-[1.1fr_0.9fr] lg:py-16">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-base-content/50">
        A place to keep your work
      </p>
      <h1
        id="home-heading"
        class="mt-5 max-w-xl text-4xl font-semibold leading-tight tracking-tight sm:text-5xl"
      >
        From an idea to the next useful step.
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-8 text-base-content/65">
        Describe a task, keep its conversation, and return to the same workspace when you’re ready to continue.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <%= if @current_scope do %>
          <.link navigate={~p"/agents"} id="home-conversations" class="btn btn-primary">Open conversations
          <.icon name="hero-arrow-right" class="size-4" /></.link>
        <% else %>
          <.link href={~p"/auth/login"} id="home-sign-in" class="btn btn-primary">Sign in to your workspace
          <.icon name="hero-arrow-right" class="size-4" /></.link>
        <% end %>
      </div>
    </div>
    <div class="rounded-3xl border border-base-300 bg-base-100 p-7 shadow-sm sm:p-9">
      <.icon name="hero-chat-bubble-left-right" class="size-9 text-base-content/65" />
      <h2 class="mt-6 text-xl font-semibold tracking-tight">Your conversation stays with you.</h2>
      <p class="mt-3 text-sm leading-7 text-base-content/60">
        Requests, recorded activity, and task limits live together. Archiving preserves the history so you can come back to it.
      </p>
      <div
        id="home-runtime-status"
        class="mt-7 rounded-xl border border-amber-300/60 bg-amber-50 p-4 text-sm leading-6 text-amber-950"
      >
        <p class="font-semibold">Conversations are available. Execution is blocked.</p>
        <p class="mt-1">
          The coding runtime needs to pass its capability checks before tasks can run.
        </p>
      </div>
    </div>
  </section>
</Layouts.app>
