# Development reads .env. Replace placeholders before starting service-backed work.
WORKOS_API_KEY=replace-with-workos-api-key
WORKOS_CLIENT_ID=replace-with-workos-client-id
WORKOS_REDIRECT_URI=http://localhost:4000/auth/workos/callback
# AUTH_PROVIDER=MyApp.AuthProvider

# Retained Sprite management stays on the host.
SPRITES_API_KEY=replace-with-sprites-api-key
# Coding uses the selected OpenAI API-key connection from WorkOS Pipes.

# Private app HTTP broker: use a different registrable domain from PHX_HOST and TLS.
APP_GATEWAY_HOST=apps.example.net

# Required for externally registered integration webhooks.
INTEGRATION_WEBHOOK_BASE_URL=https://replace-with-control-plane-host
INTEGRATION_WEBHOOK_SIGNING_SECRET=replace-with-a-random-signing-secret

# Optional scoped examples: both IDs must identify a current authorized dev actor.
# DEV_SEED_ORG_ID=org_existing
# DEV_SEED_USER_ID=user_existing

# Production release settings.
# DATABASE_URL=ecto://user:password@database/hermitscale_prod
# SECRET_KEY_BASE=replace-with-mix-phx-gen-secret-output
# PHX_HOST=control.example.com
# PHX_SERVER=true
# PORT=4000
# POOL_SIZE=10
